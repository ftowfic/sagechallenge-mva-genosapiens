    "Research question and findings", "Mechanism rationale", "Medication hypotheses",
    "Research value and next experiment", "Methods and contribution", "Reuse and execution",
    "References", "Glossary", "Disclosures", "Acknowledgement", "Supplementary index"
  ],
  "challenge_weights": {"Scientific Rigor": 35, "Potential Impact": 25, "Innovation": 25, "Scalability": 15}
