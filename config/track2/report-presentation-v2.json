  "sections": [
    "Gene and variant context",
    "Abstract",
    "Biological rationale",
    "Combined medications",
    "LINCS medications",
    "Mechanism medications",
    "Discussion",
    "Methods",
    "References",
    "Glossary",
    "Acknowledgement",
