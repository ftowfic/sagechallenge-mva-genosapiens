{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_schema",
    "path",
    "role",
    "schema",
    "size",
    "sha256",
    "dependencies"
  ],
  "properties": {
    "reference_schema": {
      "const": "genosapiens.track2-artifact-reference/v1"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
