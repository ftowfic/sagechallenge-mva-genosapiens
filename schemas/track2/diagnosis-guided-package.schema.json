{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "input_origin",
    "classification",
    "evidence_origin",
    "artifacts",
    "builder"
  ],
  "properties": {
    "schema": {
      "const": "genosapiens.track2-diagnosis-guided-package/v5"
    },
    "package_id": {
      "type": "string",
      "pattern": "^diagnosis-package:[0-9a-f]{24}$"
    },
    "input_origin": {
      "const": "diagnosis_guided_vcf"
    },
    "classification": {
      "enum": [
        "public",
        "controlled"
      ]
    },
    "evidence_origin": {
      "enum": [
        "public_source",
        "controlled_case",
        "independently_synthetic"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "selection",
        "structural",
        "variants",
        "scenarios",
        "phenotype",
        "evidence"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "scenarios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "phenotype": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "structural": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha256",
        "policy_sha256",
        "schema_sha256",
        "runtime"
      ],
      "properties": {
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "code_revision"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^.+@sha256:[0-9a-f]{64}$"
            },
            "code_revision": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
