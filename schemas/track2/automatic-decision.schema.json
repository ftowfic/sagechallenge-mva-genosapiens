                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code_sha256",
            "image"
          ],
          "properties": {
            "code_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "image": {
              "type": "string",
              "pattern": "^.+@sha256:[0-9a-f]{64}$"
            }
          }
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "accepted",
            "conflicting",
            "unresolved"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_strength": {
          "enum": [
            "policy_prediction",
