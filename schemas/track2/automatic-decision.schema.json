{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "policy",
        "domain",
        "subject_sha256",
        "evidence_sha256",
        "checks",
        "execution",
        "timestamp",
        "outcome",
        "reasons",
        "evidence_strength"
      ],
      "properties": {
        "schema": {
          "const": "genosapiens.track2-automatic-decision/v1"
        },
        "authority": {
          "const": "machine"
        },
        "policy": {
          "const": "diagnosis-automatic-acceptance/1.0.0"
        },
        "domain": {
          "enum": [
            "input",
            "mechanism",
            "plan"
          ]
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "reasons"
            ],
            "properties": {
              "state": {
                "enum": [
                  "accepted",
                  "conflicting",
                  "unresolved"
                ]
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code_sha256",
            "image"
          ],
          "properties": {
            "code_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "image": {
              "type": "string",
              "pattern": "^.+@sha256:[0-9a-f]{64}$"
            }
          }
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "accepted",
            "conflicting",
            "unresolved"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_strength": {
          "enum": [
            "policy_prediction",
            "technical_acceptance"
          ]
        }
      }
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
