{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genosapiens.track2-discovery-resources/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "classification",
    "build_id",
    "catalog",
    "source_manifests",
    "matrix",
    "policy_sha256",
    "identity_policy_sha256",
    "builder",
    "coverage_path",
    "coverage_sha256",
    "completion_sha256"
  ],
  "properties": {
    "schema": {
      "const": "genosapiens.track2-discovery-resources/v1"
    },
    "classification": {
      "const": "public"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size",
        "schema_version"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "schema_version": {
          "const": 1
        }
      }
    },
    "source_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "release",
          "path",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "release": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "producer_receipt_path",
        "producer_receipt_sha256",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "producer_receipt_path": {
          "type": "string"
        },
        "producer_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha256",
        "image"
      ],
      "properties": {
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "coverage_path": {
      "type": "string"
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completion_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
