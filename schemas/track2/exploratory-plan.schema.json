  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "policy",
    "resources",
    "objectives",
    "routes",
    "genetic_selections",
    "scenario_job_bindings",
    "excluded_scenarios",
    "coverage",
    "runtime_images"
  ],
  "properties": {
    "schema": {
      "const": "genosapiens.track2-exploratory-plan/v1"
    },
    "mode": {
      "const": "native_exploratory"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "build_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "scenario_id",
          "gene_id",
          "gene_symbol",
          "kind",
          "mechanism",
          "desired_modulation",
          "authority",
          "evidence_basis",
          "mechanism_decision_sha256",
          "source_evidence_ids",
          "policy_sha256",
          "assumptions",
          "limitations",
          "known_conflicts"
        ],
        "properties": {
          "objective_id": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "gene_id": {
            "type": "string"
          },
          "gene_symbol": {
            "type": "string"
          },
          "kind": {
            "const": "restoration_or_compensation_hypothesis"
          },
          "mechanism": {
            "const": "loss_of_function"
          },
          "desired_modulation": {
            "const": "increase"
          },
          "authority": {
            "const": "machine"
          },
          "evidence_basis": {
            "enum": [
              "policy_prediction",
              "curated_mechanism"
            ]
          },
          "mechanism_decision_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_evidence_ids": {
            "type": "array",
