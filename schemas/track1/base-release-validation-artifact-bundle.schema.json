{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ftowfic/sagechallenge-raredisease-genosapiens/schemas/track1/base-release-validation-artifact-bundle.schema.json",
  "title": "Genosapiens Track 1 base release validation artifact bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "validation_only", "plan_id", "plan_sha256", "artifacts"],
  "properties": {
    "schema": {"const": "genosapiens.track1-base-release-validation-artifact-bundle"},
    "classification": {"const": "public"},
    "validation_only": {"const": true},
    "plan_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nullableId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "binding_id", "parent_binding_id", "audience", "path", "size_bytes", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "binding_id": {"$ref": "#/$defs/nullableId"},
        "parent_binding_id": {"$ref": "#/$defs/nullableId"},
        "audience": {"enum": ["evaluator", "runner"]},
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
